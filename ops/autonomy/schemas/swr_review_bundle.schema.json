{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AutoKeel SWR review bundle",
  "type": "object",
  "required": [
    "slice",
    "run_id",
    "stage_id",
    "response_id",
    "input_sha256",
    "output_sha256",
    "reviewer_results",
    "consolidated_verdict",
    "accepted_at"
  ],
  "properties": {
    "slice": {"type": "string", "pattern": "^S[0-9]{2}$"},
    "run_id": {"type": "string", "minLength": 1},
    "stage_id": {"type": "string", "minLength": 1},
    "response_id": {"type": "string", "minLength": 1},
    "input_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "output_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "reviewer_results": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["reviewer", "verdict"],
        "properties": {
          "reviewer": {
            "enum": ["operator_codex", "codex_review_agent", "claude_review_agent"]
          },
          "verdict": {"const": "pass"}
        },
        "additionalProperties": true
      }
    },
    "consolidated_verdict": {"const": "pass"},
    "accepted_at": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
