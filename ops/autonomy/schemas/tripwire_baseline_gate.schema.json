{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://health-data-hub.local/schemas/tripwire_baseline_gate.schema.json",
  "title": "Baseline gate tripwire evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tripwire",
    "created_at",
    "status",
    "action",
    "runtime_gate_status",
    "collecting_state_enforced",
    "contains_model_metrics"
  ],
  "properties": {
    "schema_version": {
      "const": "health_data_hub.tripwire.baseline_gate.v1"
    },
    "tripwire": {
      "const": "on_baseline_gate_failure_week_9"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": ["ok", "fallback_required", "fallback_accepted"]
    },
    "action": {
      "enum": ["none", "collecting_state_no_override"]
    },
    "runtime_gate_status": {
      "enum": ["passed", "missing", "ineligible", "failed"]
    },
    "collecting_state_enforced": {
      "type": "boolean"
    },
    "contains_model_metrics": {
      "const": false
    }
  }
}
