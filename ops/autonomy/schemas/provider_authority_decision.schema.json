{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://health-data-hub.local/schemas/provider_authority_decision.schema.json",
  "title": "S12 Oura provider authority decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "created_at",
    "slice",
    "provider",
    "status",
    "agreement",
    "authority_basis",
    "provider_policy",
    "covered_uses",
    "retention_controls",
    "source_evidence",
    "insufficient_bases",
    "sanitized",
    "raw_payload_tracked",
    "secret_values_tracked"
  ],
  "properties": {
    "schema_version": {
      "const": "health_data_hub.provider_authority.oura.v1"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "slice": {
      "const": "S12"
    },
    "provider": {
      "const": "oura"
    },
    "status": {
      "enum": ["authorized", "blocked_external", "rejected"]
    },
    "agreement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "effective_date",
        "section_4a_iii_rule",
        "section_4d_rule",
        "section_6g_rule",
        "retention_rule"
      ],
      "properties": {
        "title": {
          "const": "Oura API/MCP Agreement"
        },
        "effective_date": {
          "const": "2026-06-08"
        },
        "section_4a_iii_rule": {
          "const": "prior_written_consent_exception_does_not_override_sections_4d_or_6g"
        },
        "section_4d_rule": {
          "const": "oura_api_prohibited_for_ai_model_development_training_evaluation_or_input"
        },
        "section_6g_rule": {
          "const": "user_data_training_prohibited"
        },
        "retention_rule": {
          "const": "agreement_constrained"
        }
      }
    },
    "authority_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis_type",
        "confirmed_by",
        "decision_date",
        "valid_from",
        "valid_through",
        "revoked",
        "uses_oura_api",
        "explicitly_supersedes",
        "outside_api_mcp_agreement_restrictions",
        "scope_reference"
      ],
      "properties": {
        "basis_type": {
          "enum": [
            "oura_separate_written_agreement_superseding_ai_restrictions",
            "legally_confirmed_non_api_acquisition_route",
            "none"
          ]
        },
        "confirmed_by": {
          "enum": ["oura", "qualified_legal_review", "none"]
        },
        "decision_date": {
          "type": "string",
          "format": "date"
        },
        "valid_from": {
          "type": "string",
          "format": "date"
        },
        "valid_through": {
          "type": ["string", "null"],
          "format": "date"
        },
        "revoked": {
          "const": false
        },
        "uses_oura_api": {
          "type": "boolean"
        },
        "explicitly_supersedes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "section_4d_ai_model_prohibition",
              "section_6g_user_data_training_prohibition"
            ]
          }
        },
        "outside_api_mcp_agreement_restrictions": {
          "type": "boolean"
        },
        "scope_reference": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "provider_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active_sleep_source",
        "eight_sleep_status",
        "provider_reopening"
      ],
      "properties": {
        "active_sleep_source": {
          "const": "oura"
        },
        "eight_sleep_status": {
          "const": "fallback_only"
        },
        "provider_reopening": {
          "const": false
        }
      }
    },
    "covered_uses": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {
        "enum": [
          "provider_data_acquisition",
          "local_storage",
          "finite_retention",
          "mood_correlation",
          "ridge_training",
          "ridge_evaluation",
          "retrospective_explanations",
          "local_backups",
          "raw_audit_retention"
        ]
      }
    },
    "retention_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_provider_payload_max_days",
        "raw_audit_max_days",
        "derived_data_max_days",
        "backup_max_days",
        "purge_on_authority_revocation",
        "deletion_plan_reference"
      ],
      "properties": {
        "raw_provider_payload_max_days": {
          "type": "integer",
          "minimum": 0
        },
        "raw_audit_max_days": {
          "type": "integer",
          "minimum": 0
        },
        "derived_data_max_days": {
          "type": "integer",
          "minimum": 0
        },
        "backup_max_days": {
          "type": "integer",
          "minimum": 0
        },
        "purge_on_authority_revocation": {
          "const": true
        },
        "deletion_plan_reference": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "document_type",
        "sha256",
        "size_bytes",
        "mode"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^private/evidence/S12/authority/[A-Za-z0-9][A-Za-z0-9._/-]*$"
        },
        "document_type": {
          "enum": [
            "oura_separate_written_ai_data_agreement",
            "legal_confirmation_of_non_api_route_outside_agreement_restrictions"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "mode": {
          "const": "0o600"
        }
      }
    },
    "insufficient_bases": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_acknowledgement_only",
        "oauth_or_token_only",
        "historical_smoke_only",
        "account_or_membership_only"
      ],
      "properties": {
        "user_acknowledgement_only": {
          "const": false
        },
        "oauth_or_token_only": {
          "const": false
        },
        "historical_smoke_only": {
          "const": false
        },
        "account_or_membership_only": {
          "const": false
        }
      }
    },
    "sanitized": {
      "const": true
    },
    "raw_payload_tracked": {
      "const": false
    },
    "secret_values_tracked": {
      "const": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "authority_basis": {
            "properties": {
              "basis_type": {
                "const": "oura_separate_written_agreement_superseding_ai_restrictions"
              }
            },
            "required": ["basis_type"]
          }
        }
      },
      "then": {
        "properties": {
          "authority_basis": {
            "properties": {
              "confirmed_by": {"const": "oura"},
              "uses_oura_api": {"const": true},
              "explicitly_supersedes": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "uniqueItems": true,
                "allOf": [
                  {"contains": {"const": "section_4d_ai_model_prohibition"}},
                  {"contains": {"const": "section_6g_user_data_training_prohibition"}}
                ]
              },
              "outside_api_mcp_agreement_restrictions": {"const": false}
            }
          },
          "source_evidence": {
            "properties": {
              "document_type": {"const": "oura_separate_written_ai_data_agreement"}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "authority_basis": {
            "properties": {
              "basis_type": {
                "const": "legally_confirmed_non_api_acquisition_route"
              }
            },
            "required": ["basis_type"]
          }
        }
      },
      "then": {
        "properties": {
          "authority_basis": {
            "properties": {
              "confirmed_by": {"const": "qualified_legal_review"},
              "uses_oura_api": {"const": false},
              "explicitly_supersedes": {
                "const": []
              },
              "outside_api_mcp_agreement_restrictions": {"const": true}
            }
          },
          "source_evidence": {
            "properties": {
              "document_type": {
                "const": "legal_confirmation_of_non_api_route_outside_agreement_restrictions"
              }
            }
          }
        }
      }
    }
  ]
}
