{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AutoKeel slices",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "slug", "name", "status", "required", "playbook", "brief", "autoplan"],
    "properties": {
      "id": {"type": "string", "pattern": "^S[0-9]{2}$"},
      "slug": {"type": "string"},
      "name": {"type": "string"},
      "status": {
        "type": "string",
        "enum": [
          "pending",
          "waiting_for_playbook",
          "replan_required",
          "evidence_ready",
          "blocked",
          "blocked_external",
          "blocked_external_waiting_for_evidence",
          "blocked_compile_inputs",
          "complete"
        ]
      },
      "required": {"type": "boolean"},
      "lane": {"type": "string"},
      "risk": {"type": "string"},
      "playbook": {"type": "string"},
      "brief": {"type": "string"},
      "autoplan": {"type": "string"},
      "depends_on": {"type": "array", "items": {"type": "string"}},
      "deliverables": {"type": "array", "items": {"type": "string"}},
      "review_artifacts": {"type": "array", "items": {"type": "string"}},
      "integration_review_artifacts": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"type": "string"}
      },
      "lane_decision_review_artifacts": {"type": "array", "items": {"type": "string"}},
      "integration_receipt": {"type": "string"},
      "ship_branch": {"type": "string", "minLength": 1},
      "ship_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40,64}$"},
      "integration_base_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40,64}$"},
      "acceptance": {"type": "array", "items": {"type": "string"}},
      "activation_acceptance": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "runtime_root",
          "runtime_root_env",
          "reads_private_aggregate_evidence",
          "live_warehouse_access",
          "required_after_ship_acceptance",
          "completion_requires_status"
        ],
        "properties": {
          "command": {
            "enum": [
              "python scripts/verify_mood_logging_recovery.py --runtime-root-env HEALTH_HUB_RUNTIME_ROOT --json",
              "python scripts/verify_s12_sync.py --runtime-root-env HEALTH_HUB_RUNTIME_ROOT --json"
            ]
          },
          "runtime_root": {"const": "canonical"},
          "runtime_root_env": {"const": "HEALTH_HUB_RUNTIME_ROOT"},
          "reads_private_aggregate_evidence": {"const": true},
          "live_warehouse_access": {"const": "read_only"},
          "required_after_ship_acceptance": {"const": true},
          "completion_requires_status": {"const": "ok"}
        }
      },
      "pre_po_commands": {"type": "array", "items": {"type": "string"}},
      "pre_ship_commands": {"type": "array", "items": {"type": "string"}},
      "swr_validation_repair": {
        "type": "object",
        "properties": {
          "status": {"type": "string"},
          "repair_action": {"type": ["string", "null"]},
          "repair_stage_id": {"type": ["string", "null"]},
          "source_review_stage_id": {"type": ["string", "null"]},
          "source_review_bundle": {"type": ["string", "null"]},
          "run_id": {"type": ["string", "null"]},
          "run_dir": {"type": ["string", "null"]},
          "run_manifest": {"type": ["string", "null"]},
          "rationale": {"type": ["string", "null"]}
        }
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {"status": {"const": "complete"}},
          "required": ["status"]
        },
        "then": {
          "required": ["ship_branch", "ship_commit", "integration_base_commit"]
        }
      }
    ]
  }
}
