{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AutoKeel slices",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "slug", "name", "status", "required", "playbook", "brief", "autoplan"],
    "properties": {
      "id": {"type": "string", "pattern": "^S[0-9]{2}$"},
      "slug": {"type": "string"},
      "name": {"type": "string"},
      "status": {
        "type": "string",
        "enum": [
          "pending",
          "waiting_for_playbook",
          "replan_required",
          "evidence_ready",
          "blocked",
          "blocked_external",
          "blocked_external_waiting_for_evidence",
          "blocked_compile_inputs",
          "complete"
        ]
      },
      "required": {"type": "boolean"},
      "lane": {"type": "string"},
      "risk": {"type": "string"},
      "playbook": {"type": "string"},
      "brief": {"type": "string"},
      "autoplan": {"type": "string"},
      "depends_on": {"type": "array", "items": {"type": "string"}},
      "deliverables": {"type": "array", "items": {"type": "string"}},
      "review_artifacts": {"type": "array", "items": {"type": "string"}},
      "acceptance": {"type": "array", "items": {"type": "string"}},
      "swr_validation_repair": {
        "type": "object",
        "properties": {
          "status": {"type": "string"},
          "repair_action": {"type": ["string", "null"]},
          "repair_stage_id": {"type": ["string", "null"]},
          "source_review_stage_id": {"type": ["string", "null"]},
          "source_review_bundle": {"type": ["string", "null"]},
          "run_id": {"type": ["string", "null"]},
          "run_dir": {"type": ["string", "null"]},
          "run_manifest": {"type": ["string", "null"]},
          "rationale": {"type": ["string", "null"]}
        }
      }
    }
  }
}
