{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AutoKeel decision artifact",
  "type": "object",
  "required": ["created_at", "status"],
  "properties": {
    "created_at": {"type": "string"},
    "status": {"type": "string"},
    "slice": {"type": "string"},
    "tripwire": {"type": "string"},
    "action": {"type": "string"},
    "decision": {"type": "string"},
    "reason": {"type": "string"},
    "source": {"type": "string"}
  }
}
